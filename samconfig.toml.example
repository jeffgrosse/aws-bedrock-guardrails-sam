# Copy this file to samconfig.toml and fill in your own values, or just run
# `sam deploy --guided` and let it write samconfig.toml for you.
#
# samconfig.toml is gitignored on purpose: it's meant to be regenerated per
# deployer/fork, and there's no reason to commit one deployer's stack name
# or region choice as if it were the only valid one.

version = 0.1

[default]
[default.deploy]
[default.deploy.parameters]
stack_name = "aws-bedrock-guardrails-sam"
region = "us-east-1"
confirm_changeset = true
resolve_s3 = true
parameter_overrides = "GuardrailName=\"example-guardrail\" GuardrailDescription=\"Example guardrail demonstrating content, topic, PII, and word policies.\" BlockedInputMessage=\"Sorry, I can't help with that request.\" BlockedOutputMessage=\"Sorry, I can't provide that response.\""
